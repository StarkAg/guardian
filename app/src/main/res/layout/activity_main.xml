<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnPerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_permissions" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:id="@+id/txtShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shizuku_checking"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShizuku"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/request_access" />

            <Button
                android:id="@+id/btnGuide"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/how_to_start" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:id="@+id/txtAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uninstall_checking"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_uninstall_protection" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/secret_code_label"
            android:paddingTop="20dp" />

        <EditText
            android:id="@+id/editCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/secret_code_hint"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trusted_numbers_label"
            android:paddingTop="16dp" />

        <EditText
            android:id="@+id/editTrusted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/trusted_numbers_hint"
            android:gravity="top"
            android:minLines="2"
            android:inputType="textMultiLine|phone" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/allow_pin_access" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pin_description"
            android:textSize="12sp"
            android:paddingTop="4dp" />

        <EditText
            android:id="@+id/editPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pin_hint"
            android:inputType="text" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="?android:attr/listDivider" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/use_shizuku" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/allow_root_fallback" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/auto_enable_data" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoLoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/auto_enable_location" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchRing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/allow_ring" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/sim_change_alert" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/low_battery_auto_locate" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/save_settings" />

    </LinearLayout>
</ScrollView>
